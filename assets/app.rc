1 ICON "assets/app.ico"

// Fusion manifest: carries the <msix> element that gives the process the
// identity of the registered sparse package (spec §3 Source B).
1 24 "assets/app.manifest"

// The @TOKEN@ values below are substituted by build.rs from Cargo.toml
// (version = ... and [package.metadata] product-name), so this file never
// carries a literal product name or version - the version lives in exactly
// one place (src/main.rs::version_tests::version_consistency guards it).
1 VERSIONINFO
FILEVERSION @VERSION_CSV@
PRODUCTVERSION @VERSION_CSV@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@PRODUCT_NAME@"
            VALUE "FileDescription", "@PRODUCT_NAME@"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "taskbar-island"
            VALUE "LegalCopyright", "Copyright (C) 2026 @PRODUCT_NAME@"
            VALUE "OriginalFilename", "taskbar-island.exe"
            VALUE "ProductName", "@PRODUCT_NAME@"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
